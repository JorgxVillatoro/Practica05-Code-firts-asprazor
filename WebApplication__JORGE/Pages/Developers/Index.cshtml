@page
@model WebApplication__JORGE.Pages.Developers.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EmpleadoDeveloper[0].BugsReparados)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmpleadoDeveloper[0].AplicacionesCreadas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmpleadoDeveloper[0].Nombre)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.EmpleadoDeveloper) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.BugsReparados)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AplicacionesCreadas)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
